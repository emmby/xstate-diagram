stateDiagram-v2
  [*] --> bead_system_calibrating
  state "calibrating" as bead_system_calibrating
  bead_system_calibrating : entry / runCalibration
  bead_system_calibrating : entry / renderCalibration
  state "training_prompt" as bead_system_training_prompt
  bead_system_training_prompt : entry / renderTrainingPrompt
  state "training_capture" as bead_system_training_capture
  bead_system_training_capture : entry / captureTrainingBead
  bead_system_training_capture : entry / renderCapturing
  state "production_idle" as bead_system_production_idle
  bead_system_production_idle : entry / servoDown
  bead_system_production_idle : entry / renderIdle
  state "down_pause" as bead_system_down_pause
  bead_system_down_pause : entry / servoDown
  bead_system_down_pause : entry / renderDown
  state "moving_up" as bead_system_moving_up
  bead_system_moving_up : entry / servoUp
  bead_system_moving_up : entry / renderUp
  state "reading_bead" as bead_system_reading_bead
  bead_system_reading_bead : entry / takeProductionReading

  bead_system_calibrating --> bead_system_training_prompt : after 100
  bead_system_training_prompt --> bead_system_training_capture : BTN_PRESS
  bead_system_training_capture --> bead_system_training_prompt : NEXT_BEAD
  bead_system_training_capture --> bead_system_production_idle : FINISH_TRAINING
  bead_system_production_idle --> bead_system_down_pause : BTN_PRESS
  bead_system_down_pause --> bead_system_moving_up : after 500
  bead_system_moving_up --> bead_system_reading_bead : after 400
  bead_system_reading_bead --> bead_system_production_idle : after 100

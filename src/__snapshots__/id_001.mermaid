stateDiagram-v2
  [*] --> A
  state "A" as A {
    [*] --> A_foo
    state "foo" as A_foo
    state "bar" as A_bar
  }
  state "B" as B {
    [*] --> B_foo
    state "foo" as B_foo
    state "bar" as B_bar
    state "dot" as B_dot
  }

  A_foo --> A_bar : NEXT
  A_bar --> B_foo : NEXT
  A --> B_bar : NEXT_DOT_RESOLVE
  B_foo --> B_bar : NEXT
  B_foo --> B_dot : NEXT_DOT
  B_bar --> A_foo : NEXT

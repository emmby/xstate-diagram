{
  "id": "bead_system",
  "initial": "calibrating",
  "states": {
    "calibrating": {
      "entry": ["runCalibration", "renderCalibration"],
      "after": { "100": { "target": "training_prompt" } }
    },
    "training_prompt": {
      "entry": ["renderTrainingPrompt"],
      "on": { 
        "BTN_PRESS": { "target": "training_capture" }
      }
    },
    "training_capture": {
      "entry": ["captureTrainingBead", "renderCapturing"],
      "on": { 
          "NEXT_BEAD": { "target": "training_prompt" },
          "FINISH_TRAINING": { "target": "production_idle" }
      }
    },
    "production_idle": {
      "entry": ["servoDown", "renderIdle"],
      "on": { "BTN_PRESS": { "target": "down_pause" } }
    },
    "down_pause": {
      "entry": ["servoDown", "renderDown"],
      "after": { "500": { "target": "moving_up" } }
    },
    "moving_up": {
      "entry": ["servoUp", "renderUp"],
      "after": { "400": { "target": "reading_bead" } }
    },
    "reading_bead": {
      "entry": ["takeProductionReading"],
      "after": { "100": { "target": "production_idle" } }
    }
  }
}

{
  "types": "[Node: {} as { context: { count: number } }]",
  "id": "interval",
  "initial": "counting",
  "context": {
    "count": 0
  },
  "states": {
    "counting": {
      "invoke": {
        "id": "intervalService",
        "src": "[Node: fromCallback(({ sendBack }) => {\n                const ivl = setInterval(() => {\n                  sendBack({ type: 'INC' });\n                }, 10);\n\n                return () => clearInterval(ivl);\n              })]"
      },
      "always": {
        "target": "finished",
        "guard": "[Node: ({ context }) => context.count === 3]"
      },
      "on": {
        "INC": {
          "actions": "[Node: assign({ count: ({ context }) => context.count + 1 })]"
        }
      }
    },
    "finished": {
      "type": "final"
    }
  }
}
{
  "id": "fetch",
  "types": "[Node: {} as {\n        context: { userId: string | undefined; user?: typeof user | undefined };\n        events: {\n          type: 'RESOLVE';\n          user: typeof user;\n        };\n        input: { userId: string };\n      }]",
  "context": "[Node: ({ input }) => ({\n        userId: input.userId\n      })]",
  "initial": "pending",
  "states": {
    "pending": {
      "entry": "[Node: raise({ type: 'RESOLVE', user })]",
      "on": {
        "RESOLVE": {
          "target": "success",
          "guard": "[Node: ({ context }) => {\n                return context.userId !== undefined;\n              }]"
        }
      }
    },
    "success": {
      "type": "final",
      "entry": "[Node: assign({\n            user: ({ event }) => event.user\n          })]"
    },
    "failure": {
      "entry": "[Node: sendParent({ type: 'REJECT' })]"
    }
  },
  "output": "[Node: ({ context }) => ({ user: context.user })]"
}
{
  "types": "[Node: {} as { context: { one?: string; two?: string } }]",
  "id": "machine",
  "initial": "one",
  "context": {},
  "on": {
    "ONE": {
      "actions": "[Node: assign({\n            one: 'one'\n          })]"
    },
    "TWO": {
      "actions": "[Node: assign({\n            two: 'two'\n          })]",
      "target": ".three"
    }
  },
  "states": {
    "one": {
      "initial": "two",
      "states": {
        "two": {
          "invoke": [
            {
              "id": "child",
              "src": "[Node: fromCallback(({ sendBack }) => sendBack({ type: 'ONE' }))]"
            },
            {
              "id": "child2",
              "src": "[Node: fromCallback(({ sendBack }) => sendBack({ type: 'TWO' }))]"
            }
          ]
        }
      }
    },
    "three": {
      "type": "final"
    }
  }
}
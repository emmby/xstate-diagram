{
  "id": "parent",
  "types": "[Node: {} as {\n          context: { count: number };\n          actors: {\n            src: 'child';\n            id: 'someService';\n            logic: typeof childMachine;\n          };\n        }]",
  "context": {
    "count": 0
  },
  "initial": "start",
  "states": {
    "start": {
      "invoke": {
        "src": "child",
        "id": "someService"
      },
      "always": {
        "target": "stop",
        "guard": "[Node: ({ context }) => context.count === -3]"
      },
      "on": {
        "DEC": {
          "actions": "[Node: assign({ count: ({ context }) => context.count - 1 })]"
        },
        "FORWARD_DEC": {
          "actions": "[Node: sendTo('someService', { type: 'FORWARD_DEC' })]"
        }
      }
    },
    "stop": {
      "type": "final"
    }
  }
}
{
  "types": "[Node: {} as { context: { count: number | undefined }; events: Events }]",
  "id": "obs",
  "initial": "counting",
  "context": {
    "count": "[Node: undefined]"
  },
  "states": {
    "counting": {
      "invoke": {
        "src": "[Node: fromEventObservable(() =>\n                interval(10).pipe(map((value) => ({ type: 'COUNT', value })))\n              )]"
      },
      "on": {
        "COUNT": {
          "actions": "[Node: assign({ count: ({ event }) => event.value })]"
        }
      },
      "always": {
        "target": "counted",
        "guard": "[Node: ({ context }) => context.count === 5]"
      }
    },
    "counted": {
      "type": "final"
    }
  }
}
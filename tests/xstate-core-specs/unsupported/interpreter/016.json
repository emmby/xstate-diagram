{
  "types": "[Node: {} as { context: { count: number } }]",
  "id": "log",
  "initial": "x",
  "context": {
    "count": 0
  },
  "states": {
    "x": {
      "on": {
        "LOG": {
          "actions": [
            "[Node: assign({ count: ({ context }) => context.count + 1 })]",
            "[Node: log(({ context }) => context)]"
          ]
        }
      }
    }
  }
}
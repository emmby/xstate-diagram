{
  "types": "[Node: {} as { context: { data: number; other: string } }]",
  "context": {
    "data": 42,
    "other": "foo"
  },
  "initial": "G",
  "states": {
    "G": {
      "on": {
        "INC": {
          "actions": "[Node: assign({ data: ({ context }) => context.data + 1 })]"
        }
      }
    }
  }
}
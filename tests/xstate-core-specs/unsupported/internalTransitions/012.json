{
  "types": "[Node: {} as {\n        context: {\n          sourceStateExits: number;\n          directDescendantExits: number;\n          deepDescendantExits: number;\n        };\n      }]",
  "context": {
    "sourceStateExits": 0,
    "directDescendantExits": 0,
    "deepDescendantExits": 0
  },
  "initial": "a1",
  "states": {
    "a1": {
      "initial": "a11",
      "exit": "[Node: assign({\n            sourceStateExits: ({ context }) => context.sourceStateExits + 1\n          })]",
      "states": {
        "a11": {
          "initial": "a111",
          "exit": "[Node: assign({\n                directDescendantExits: ({ context }) =>\n                  context.directDescendantExits + 1\n              })]",
          "states": {
            "a111": {
              "exit": "[Node: assign({\n                    deepDescendantExits: ({ context }) =>\n                      context.deepDescendantExits + 1\n                  })]"
            }
          }
        }
      },
      "on": {
        "REENTER": ".a11.a111"
      }
    }
  }
}
{
  "types": "[Node: {} as {\n        events:\n          | {\n              type: 'SOMETHING';\n            }\n          | {\n              type: 'SOMETHING_ELSE';\n            };\n      }]",
  "on": {
    "SOMETHING": {
      "actions": "[Node: enqueueActions(({ enqueue }) => {\n            enqueue.raise({ type: 'SOMETHING_ELSE' });\n          })]"
    }
  }

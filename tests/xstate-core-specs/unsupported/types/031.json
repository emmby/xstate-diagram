{
  "types": {
    "context": "[Node: {} as {\n          count: number;\n        }]",
    "events": "[Node: {} as\n          | { type: 'EVENT_WITH_FLAG'; flag: boolean }\n          | {\n              type: 'EVENT_WITHOUT_FLAG';\n            }]"
  },
  "context": {
    "count": 0
  },
  "on": {
    "*": {
      "actions": "[Node: ({ event }) => {\n            ((_accept: 'EVENT_WITH_FLAG' | 'EVENT_WITHOUT_FLAG') => {})(\n              event.type\n            );\n            // @ts-expect-error\n            ((_accept: 'is not any') => {})(event);\n          }]"
    }
  }
}
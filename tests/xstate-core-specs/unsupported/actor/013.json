{
  "types": "[Node: {} as {\n          actors: {\n            src: 'interval';\n            id: 'childActor';\n            logic: typeof intervalActor;\n          };\n        }]",
  "initial": "active",
  "states": {
    "active": {
      "invoke": {
        "id": "childActor",
        "src": "interval",
        "onSnapshot": {
          "target": "success",
          "guard": "[Node: ({ event }) => {\n                  return event.snapshot.context === 3;\n                }]"
        }
      }
    },
    "success": {
      "type": "final"
    }
  }
}
{
  "invoke": {
    "id": "myChild",
    "src": "[Node: child]"
  },
  "initial": "initial",
  "states": {
    "initial": {
      "on": {
        "CHILD_UPDATED": [
          {
            "guard": "[Node: () => {\n                  return (\n                    service.getSnapshot().children.myChild.getSnapshot()\n                      .value === 'b'\n                  );\n                }]",
            "target": "success"
          },
          {
            "target": "fail"
          }
        ]
      }
    },
    "success": {
      "type": "final"
    },
    "fail": {
      "type": "final"
    }
  }
}
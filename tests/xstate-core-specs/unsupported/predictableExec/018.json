{
  "invoke": {
    "id": "myChild",
    "src": "[Node: child]"
  },
  "initial": "initial",
  "states": {
    "initial": {
      "on": {
        "CHILD_UPDATED": [
          {
            "guard": "[Node: () =>\n                  service.getSnapshot().children.myChild.getSnapshot().value ===\n                  'b']",
            "target": "success"
          },
          {
            "target": "fail"
          }
        ]
      }
    },
    "success": {
      "type": "final"
    },
    "fail": {
      "type": "final"
    }
  }
}
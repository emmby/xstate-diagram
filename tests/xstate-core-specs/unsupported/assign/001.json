{
  "types": "[Node: {} as { context: CounterContext }]",
  "initial": "counting",
  "context": {
    "count": 0,
    "foo": "bar"
  },
  "states": {
    "counting": {
      "on": {
        "INC": [
          {
            "target": "counting",
            "actions": "[Node: assign(({ context }) => ({\n                count: context.count + 1\n              }))]"
          }
        ],
        "DEC": [
          {
            "target": "counting",
            "actions": [
              "[Node: assign({\n                  count: ({ context }) => context.count - 1\n                })]"
            ]
          }
        ],
        "WIN_PROP": [
          {
            "target": "counting",
            "actions": [
              "[Node: assign({\n                  count: () => 100,\n                  foo: () => 'win'\n                })]"
            ]
          }
        ],
        "WIN_STATIC": [
          {
            "target": "counting",
            "actions": [
              "[Node: assign({\n                  count: 100,\n                  foo: 'win'\n                })]"
            ]
          }
        ],
        "WIN_MIX": [
          {
            "target": "counting",
            "actions": [
              "[Node: assign({\n                  count: () => 100,\n                  foo: 'win'\n                })]"
            ]
          }
        ],
        "WIN": [
          {
            "target": "counting",
            "actions": [
              "[Node: assign(() => ({\n                  count: 100,\n                  foo: 'win'\n                }))]"
            ]
          }
        ],
        "SET_MAYBE": [
          {
            "actions": [
              "[Node: assign({\n                  maybe: 'defined'\n                })]"
            ]
          }
        ]
      }
    }
  }
}
{
  "types": "[Node: {} as { context: { count: number } }]",
  "id": "machine",
  "initial": "first",
  "context": {
    "count": 0
  },
  "states": {
    "first": {
      "on": {
        "ADD": {
          "actions": "[Node: assign({ count: ({ context }) => context.count + 1 })]"
        }
      }
    },
    "success": {
      "type": "final"
    }
  },
  "always": [
    {
      "target": ".success",
      "guard": "[Node: ({ context }) => {\n            return context.count > 0;\n          }]"
    }
  ]
}
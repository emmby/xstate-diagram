{
  "initial": "a",
  "states": {
    "a": {
      "on": {
        "EVENT": "b"
      }
    },
    "b": {
      "always": {
        "target": "c",
        "actions": "[Node: ({ event }) => {\n              expect(event).toEqual({ type: 'EVENT', value: 42 });\n            }]"
      },
      "exit": "[Node: ({ event }) => {\n            expect(event).toEqual({ type: 'EVENT', value: 42 });\n          }]"
    },
    "c": {
      "entry": "[Node: ({ event }) => {\n            expect(event).toEqual({ type: 'EVENT', value: 42 });\n          }]"
    }
  }
}
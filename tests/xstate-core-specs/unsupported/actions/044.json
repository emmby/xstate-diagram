{
  "types": "[Node: {} as {\n          context: {\n            child: ActorRefFromLogic<typeof child>;\n          };\n        }]",
  "id": "parent",
  "context": "[Node: ({ spawn }) => ({\n          child: spawn(child)\n        })]",
  "on": {
    "FINISH_CHILD": {
      "actions": "[Node: sendTo(({ context }) => context.child, { type: 'FINISH' })]"
    },
    "CHILD_DONE": {
      "actions": "[Node: () => {\n              eventReceived = true;\n            }]"
    }
  }
}
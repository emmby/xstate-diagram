{
  "initial": "foo",
  "states": {
    "foo": {
      "exit": "[Node: () => {\n              exitActions.push('foo action');\n            }]",
      "on": {
        "INITIALIZE_SYNC_SEQUENCE": {
          "target": "bar",
          "actions": [
            "[Node: () => {\n                    // immediately stop *while* the `INITIALIZE_SYNC_SEQUENCE` is still being processed\n                    service.stop();\n                  }]",
            "[Node: () => {}]"
          ]
        }
      }
    },
    "bar": {
      "exit": "[Node: () => {\n              exitActions.push('bar action');\n            }]"
    }
  }
}
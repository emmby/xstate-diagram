{
  "name": "xstate-diagram",
  "version": "0.2.0",
  "description": "Convert XState v5 state machines into publication-quality SVG statechart diagrams with closed-loop verification",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emmby/xstate-diagram.git"
  },
  "homepage": "https://emmby.github.io/xstate-diagram/",
  "bugs": {
    "url": "https://github.com/emmby/xstate-diagram/issues"
  },
  "keywords": [
    "xstate",
    "statechart",
    "state-machine",
    "svg",
    "diagram",
    "elkjs",
    "harel",
    "visualization"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "xstate-diagram": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "ARCHITECTURE.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "build:playground": "tsx scripts/build-playground.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "gallery:tier1": "tsx src/verifier/gallery.ts 1",
    "gallery:tier2": "tsx src/verifier/gallery.ts 2",
    "gallery:tier3": "tsx src/verifier/gallery.ts 3",
    "gallery:tier4": "tsx src/verifier/gallery.ts 4"
  },
  "dependencies": {
    "elkjs": "^0.9.3",
    "xstate": "^5.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "playwright": "^1.49.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}

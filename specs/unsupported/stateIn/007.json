      }
    },
    "yellow": {
      "on": {
        "TIMER": "red"
      }
    },
    "red": {
      "initial": "walk",
      "states": {
        "walk": {
          "on": {
            "TIMER": "wait"
          }
        },
        "wait": {
          "on": {

{
  "id": "toggle",
  "initial": "inactive",
  "states": {
    "fail": {},
    "inactive": {
      "on": {
        "INACTIVATE": "fail",
        "ACTIVATE": "active"
      }
    },
    "active": {
      "on": {
        "INACTIVATE": "success"
      }
    },
    "success": {
      "type": "final"
    }
  }
}
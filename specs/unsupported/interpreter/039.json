{
  "initial": "active",
  "types": "[Node: {} as {\n            actors: {\n              src: 'num';\n              logic: PromiseActorLogic<number>;\n            };\n          }]",
  "states": {
    "active": {
      "invoke": {
        "id": "childActor",
        "src": "num",
        "onDone": [
          {
            "target": "success",
            "guard": "[Node: ({ event }) => {\n                      return event.output === 42;\n                    }]"
          },
          {
            "target": "failure"
          }
        ]
      }
    },
    "success": {
      "type": "final"
    },
    "failure": {
      "type": "final"
    }
  }
}
{
  "types": "[Node: {} as { context: Ctx; events: Events }]",
  "id": "sendexpr",
  "initial": "start",
  "context": {
    "password": "foo"
  },
  "states": {
    "start": {
      "entry": "[Node: raise(({ context }) => ({\n            type: 'NEXT' as const,\n            password: context.password\n          }))]",
      "on": {
        "NEXT": {
          "target": "finish",
          "guard": "[Node: ({ event }) => event.password === 'foo']"
        }
      }
    },
    "finish": {
      "type": "final"
    }
  }
}
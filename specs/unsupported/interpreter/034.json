{
  "types": "[Node: {} as { context: typeof countContext }]",
  "context": "[Node: countContext]",
  "initial": "active",
  "states": {
    "active": {
      "always": {
        "target": "finished",
        "guard": "[Node: ({ context }) => context.count >= 5]"
      },
      "on": {
        "INC": {
          "actions": "[Node: assign({ count: ({ context }) => context.count + 1 })]"
        }
      }
    },
    "finished": {
      "type": "final"
    }
  }
}
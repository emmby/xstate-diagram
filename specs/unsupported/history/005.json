{
  "initial": "idle",
  "states": {
    "idle": {
      "id": "idle",
      "initial": "absent",
      "states": {
        "absent": {
          "on": {
            "DEPLOY": "#deploy"
          }
        },
        "present": {
          "on": {
            "DEPLOY": "#deploy",
            "DESTROY": "#destroy"
          }
        },
        "hist": {
          "type": "history"
        }
      }
    },
    "deploy": {
      "id": "deploy",
      "on": {
        "SUCCESS": "idle.present",
        "FAILURE": "idle.hist"
      }
    },
    "destroy": {
      "id": "destroy",
      "always": [
        {
          "target": "idle.absent"
        }
      ]
    }
  }
}
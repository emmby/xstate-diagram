{
  "initial": "a",
  "states": {
    "a": {
      "on": {
        "REENTER": {
          "target": "#b_hist",
          "reenter": true
        }
      },
      "initial": "a1",
      "states": {
        "a1": {
          "on": {
            "NEXT": "a2"
          }
        },
        "a2": {
          "entry": "[Function/Identifier: () => actual.push('a2 entered'...]",
          "exit": "[Function/Identifier: () => actual.push('a2 exited')...]"
        },
        "a3": {
          "type": "history",
          "id": "b_hist"
        }
      }
    }
  }
}
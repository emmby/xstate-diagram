{
  "context": {
    "counter": 0
  },
  "initial": "a",
  "states": {
    "a": {
      "invoke": {
        "src": "[Node: fromCallback(() => {\n              active = true;\n              return () => (active = false);\n            })]"
      },
      "always": {
        "guard": "[Node: ({ context }) => context.counter !== 0]",
        "target": "b"
      },
      "on": {
        "INC": {
          "actions": "[Node: assign(({ context }) => ({\n                counter: context.counter + 1\n              }))]"
        }
      }
    },
    "b": {}
  }
}
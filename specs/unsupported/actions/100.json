{
  "context": {
    "counter": 0
  },
  "initial": "a",
  "states": {
    "a": {
      "on": {
        "NEXT": "b"
      }
    },
    "b": {
      "entry": [
        "[Node: assign({ counter: 1 })]",
        "[Node: sendTo(({ self }) => self, { type: 'EVENT' })]"
      ],
      "on": {
        "EVENT": {
          "actions": "[Node: ({ self }) => spy(self.getSnapshot().context)]",
          "target": "c"
        }
      }
    },
    "c": {}
  }
}
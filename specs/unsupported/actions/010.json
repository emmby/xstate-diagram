{
  "type": "parallel",
  "states": {
    "a": {
      "initial": "a1",
      "states": {
        "a1": {
          "on": {
            "CHANGE": {
              "target": "a2",
              "actions": [
                "[Node: () => actual.push('do_a2')]",
                "[Node: () => actual.push('another_do_a2')]"
              ]
            }
          },
          "entry": "[Node: () => actual.push('enter_a1')]",
          "exit": "[Node: () => actual.push('exit_a1')]"
        },
        "a2": {
          "entry": "[Node: () => actual.push('enter_a2')]",
          "exit": "[Node: () => actual.push('exit_a2')]"
        }
      },
      "entry": "[Node: () => actual.push('enter_a')]",
      "exit": "[Node: () => actual.push('exit_a')]"
    },
    "b": {
      "initial": "b1",
      "states": {
        "b1": {
          "on": {
            "CHANGE": {
              "target": "b2",
              "actions": "[Node: () => actual.push('do_b2')]"
            }
          },
          "entry": "[Node: () => actual.push('enter_b1')]",
          "exit": "[Node: () => actual.push('exit_b1')]"
        },
        "b2": {
          "entry": "[Node: () => actual.push('enter_b2')]",
          "exit": "[Node: () => actual.push('exit_b2')]"
        }
      },
      "entry": "[Node: () => actual.push('enter_b')]",
      "exit": "[Node: () => actual.push('exit_b')]"
    }
  }
}
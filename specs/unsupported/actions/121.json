{
  "types": "[Node: {} as {\n        context: { counter: number };\n      }]",
  "context": {
    "counter": 0
  },
  "on": {
    "EV": {
      "actions": [
        "[Node: assign({ counter: ({ context }) => context.counter + 1 })]",
        "[Node: ({ context }) => captured.push(context.counter)]"
      ]
    }
  }
}
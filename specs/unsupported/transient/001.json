{
  "types": "[Node: {} as { context: typeof greetingContext }]",
  "id": "greeting",
  "initial": "pending",
  "context": "[Node: greetingContext]",
  "states": {
    "pending": {
      "always": [
        {
          "target": "morning",
          "guard": "[Node: ({ context }) => context.hour < 12]"
        },
        {
          "target": "afternoon",
          "guard": "[Node: ({ context }) => context.hour < 18]"
        },
        {
          "target": "evening"
        }
      ]
    },
    "morning": {},
    "afternoon": {},
    "evening": {}
  },
  "on": {
    "CHANGE": {
      "actions": "[Node: assign({ hour: 20 })]"
    },
    "RECHECK": "#greeting"
  }
}
{
  "initial": "initial",
  "context": "[Node: ({ input }: { input: { duration: number } }) => ({\n        duration: input.duration\n      })]",
  "types": {
    "context": "[Node: {} as { duration: number }]"
  },
  "states": {
    "initial": {
      "always": [
        {
          "target": "[Node: `finished`]",
          "guard": "[Node: ({ context }) => context.duration < 1000]"
        },
        {
          "target": "[Node: `active`]"
        }
      ]
    },
    "active": {},
    "finished": {
      "type": "final"
    }
  }
}
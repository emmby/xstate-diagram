{
  "initial": "a",
  "states": {
    "a": {
      "on": {
        "EVENT": "b"
      }
    },
    "b": {
      "always": "c"
    },
    "c": {
      "always": {
        "guard": "[Node: ({ event }) => {\n              expect(event.type).toEqual('EVENT');\n              return event.type === 'EVENT';\n            }]",
        "target": "d"
      }
    },
    "d": {
      "type": "final"
    }
  }
}
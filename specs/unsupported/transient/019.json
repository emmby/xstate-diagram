{
  "initial": "idle",
  "states": {
    "idle": {
      "on": {
        "event": "active"
      }
    },
    "active": {
      "initial": "a",
      "states": {
        "a": {},
        "b": {}
      },
      "always": [
        {
          "guard": "[Node: () => true]",
          "target": ".a"
        },
        {
          "target": ".b"
        }
      ]
    }
  }
}
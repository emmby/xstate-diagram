{
  "types": "[Node: {} as { context: { data: boolean } }]",
  "context": {
    "data": false
  },
  "initial": "G",
  "states": {
    "G": {
      "on": {
        "UPDATE_BUTTON_CLICKED": "E"
      }
    },
    "E": {
      "always": [
        {
          "target": "D",
          "guard": "[Node: ({ context: { data } }) => !data]"
        },
        {
          "target": "F"
        }
      ]
    },
    "D": {},
    "F": {}
  }
}
{
  "types": "[Node: {} as { context: { value: string }; events: Events }]",
  "id": "yamlEditor",
  "type": "parallel",
  "context": {
    "value": ""
  },
  "states": {
    "editing": {
      "on": {
        "CHANGE": {
          "actions": "[Node: assign({\n                value: ({ event }) => event.value\n              })]"
        }
      }
    },
    "status": {
      "initial": "unsaved",
      "states": {
        "unsaved": {
          "on": {
            "SAVE": {
              "target": "saved",
              "actions": "save"
            }
          }
        },
        "saved": {
          "on": {
            "CHANGE": "unsaved"
          }
        }
      }
    }
  }
}
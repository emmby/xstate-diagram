{
  "id": "test",
  "context": {
    "log": []
  },
  "type": "parallel",
  "states": {
    "foo": {
      "initial": "foobar",
      "states": {
        "foobar": {
          "on": {
            "GOTO_FOOBAZ": "foobaz"

{
  "types": "[Node: {} as { context: { log: string[] } }]",
  "id": "test",
  "context": {
    "log": []
  },
  "type": "parallel",
  "states": {
    "foo": {
      "initial": "foobar",
      "states": {
        "foobar": {
          "on": {
            "GOTO_FOOBAZ": "foobaz"
          }
        },
        "foobaz": {
          "entry": "[Node: assign({\n                  log: ({ context }) => [...context.log, 'entered foobaz']\n                })]",
          "on": {
            "GOTO_FOOBAZ": {
              "target": "foobaz",
              "reenter": true
            }
          }
        }
      }
    },
    "bar": {}
  }
}
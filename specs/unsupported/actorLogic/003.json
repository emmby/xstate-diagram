{
  "initial": "running",
  "states": {
    "running": {
      "invoke": {
        "src": "[Node: p]",
        "id": "p",
        "onDone": "done"
      },
      "on": {
        "cancel": "canceled"
      }
    },
    "done": {
      "on": {
        "restart": "running"
      }
    },
    "canceled": {
      "on": {
        "restart": "running"
      }
    }
  }
}
{
  "type": "parallel",
  "states": {
    "p1": {
      "initial": "running",
      "states": {
        "running": {
          "invoke": {
            "src": "[Node: p]",
            "id": "p"
          },
          "on": {
            "CANCEL_1": "canceled"
          }
        },
        "canceled": {}
      }
    },
    "p2": {
      "initial": "running",
      "states": {
        "running": {
          "invoke": {
            "src": "[Node: p]",
            "id": "p",
            "onDone": "done"
          }
        },
        "done": {}
      }
    }
  }
}
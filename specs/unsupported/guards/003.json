{
  "types": "[Node: {} as { context: LightMachineCtx; events: LightMachineEvents }]",
  "context": {
    "elapsed": 10
  },
  "initial": "yellow",
  "states": {
    "green": {
      "on": {
        "TIMER": [
          {
            "target": "green",
            "guard": "[Node: ({ context: { elapsed } }) => elapsed < 100]"
          },
          {
            "target": "yellow",
            "guard": "[Node: ({ context: { elapsed } }) =>\n                    elapsed >= 100 && elapsed < 200]"
          }
        ],
        "EMERGENCY": {
          "target": "red",
          "guard": "[Node: ({ event }) => !!event.isEmergency]"
        }
      }
    },
    "yellow": {
      "on": {
        "TIMER": {
          "target": "red",
          "guard": "minTimeElapsed"
        }
      }
    },
    "red": {}
  }
}
{
  "types": "[Node: {} as {\n        input: { elapsed?: number };\n        context: LightMachineCtx;\n        events: LightMachineEvents;\n      }]",
  "context": "[Node: ({ input = {} }) => ({\n        elapsed: input.elapsed ?? 0\n      })]",
  "initial": "green",
  "states": {
    "green": {
      "on": {
        "TIMER": [
          {
            "target": "green",
            "guard": "[Node: ({ context: { elapsed } }) => elapsed < 100]"
          },
          {
            "target": "yellow",
            "guard": "[Node: ({ context: { elapsed } }) =>\n                  elapsed >= 100 && elapsed < 200]"
          }
        ],
        "EMERGENCY": {
          "target": "red",
          "guard": "[Node: ({ event }) => !!event.isEmergency]"
        }
      }
    },
    "yellow": {
      "on": {
        "TIMER": {
          "target": "red",
          "guard": "minTimeElapsed"
        },
        "TIMER_COND_OBJ": {
          "target": "red",
          "guard": {
            "type": "minTimeElapsed"
          }
        }
      }
    },
    "red": {
      "on": {
        "BAD_COND": {
          "target": "red",
          "guard": "doesNotExist"
        }
      }
    }
  }
}
{
  "types": "[Node: {} as { context: Ctx }]",
  "initial": "secret",
  "context": {
    "revealedSecret": "[Node: undefined]"
  },
  "states": {
    "secret": {
      "initial": "wait",
      "states": {
        "wait": {
          "on": {
            "REQUEST_SECRET": "reveal"
          }
        },
        "reveal": {
          "type": "final",
          "output": "[Node: () => ({\n                secret: 'the secret'\n              })]"
        }
      },
      "onDone": {
        "target": "success",
        "actions": "[Node: assign({\n              revealedSecret: ({ event }) => {\n                return (event.output as any).secret;\n              }\n            })]"
      }
    },
    "success": {
      "type": "final"
    }
  }
}
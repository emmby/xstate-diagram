{
  "context": {
    "count": 0
  },
  "initial": "a",
  "states": {
    "a": {
      "initial": "a1",
      "states": {
        "a1": {
          "on": {
            "NEXT": "a2"
          }
        },
        "a2": {
          "type": "final",
          "entry": "[Node: assign({\n                count: 1\n              })]",
          "output": "[Node: ({ context }) => context.count]"
        }
      },
      "onDone": {
        "actions": "[Node: ({ event }) => {\n              spy(event.output);\n            }]"
      }
    }
  }
}
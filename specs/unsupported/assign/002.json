{
  "types": "[Node: {} as {\n        context: { count: number };\n        events: { type: 'INC'; value: number };\n      }]",
  "initial": "active",
  "context": {
    "count": 0
  },
  "states": {
    "active": {
      "on": {
        "INC": {
          "actions": "[Node: assign({\n                count: ({ event }) => event.value\n              })]"
        }
      }
    }
  }
}
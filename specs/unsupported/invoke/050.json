{
  "id": "parent",
  "initial": "begin",
  "states": {
    "begin": {
      "invoke": {
        "src": "[Node: anotherChildMachine]",
        "id": "invoked.child",
        "onDone": "completed"
      },
      "on": {
        "STOPCHILD": {
          "actions": "[Node: sendTo('invoked.child', { type: 'STOP' })]"
        }
      }
    },
    "completed": {
      "type": "final"
    }
  }
}
{
  "types": "[Node: {} as { context: { counter: number } }]",
  "initial": "active",
  "context": {
    "counter": 0
  },
  "states": {
    "active": {
      "invoke": {
        "src": "[Node: fromCallback(() => {\n                actorStartedCount++;\n              })]"
      },
      "always": [
        {
          "guard": "[Node: ({ context }) => context.counter === 0]",
          "target": "inactive"
        }
      ]
    },
    "inactive": {
      "entry": "[Node: assign({ counter: ({ context }) => ++context.counter })]",
      "always": "active"
    }
  }
}
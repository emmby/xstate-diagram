{
  "id": "parent",
  "context": {
    "count": 0
  },
  "initial": "start",
  "states": {
    "start": {
      "invoke": {
        "src": "child",
        "id": "someService"
      },
      "always": {
        "target": "stop",
        "guard": "[Function/Identifier: ({ context }) => context.count...]"
      },
      "on": {
        "DEC": {
          "actions": "[Call: assign]"
        },
        "FORWARD_DEC": {
          "actions": "[Call: sendTo]"
        }
      }
    },
    "stop": {
      "type": "final"
    }
  }
}
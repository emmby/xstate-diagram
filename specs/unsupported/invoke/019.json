{
  "id": "ping",
  "type": "parallel",
  "states": {
    "one": {
      "initial": "active",
      "states": {
        "active": {
          "invoke": {
            "id": "pong",
            "src": "[Node: pongMachine]",
            "onDone": {
              "target": "success",
              "guard": "[Node: ({ event }) => event.output.secret === 'pingpong']"
            }
          }
        },
        "success": {
          "type": "final"
        }
      }
    }
  }
}
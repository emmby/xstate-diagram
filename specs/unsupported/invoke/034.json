{
  "types": "[Node: {} as {\n              context: {\n                result1: number | null;\n                result2: number | null;\n              };\n              actors: {\n                src: 'getRandomNumber';\n                logic: PromiseActorLogic<{ result: number }>;\n              };\n            }]",
  "context": {
    "result1": "[Node: null]",
    "result2": "[Node: null]"
  },
  "initial": "pending",
  "states": {
    "pending": {
      "type": "parallel",
      "states": {
        "state1": {
          "initial": "active",
          "states": {
            "active": {
              "invoke": {
                "src": "getRandomNumber",
                "onDone": {
                  "target": "success",
                  "actions": "[Node: assign(({ event }) => ({\n                              result1: event.output.result\n                            }))]"
                }
              }
            },
            "success": {
              "type": "final"
            }
          }
        },
        "state2": {
          "initial": "active",
          "states": {
            "active": {
              "invoke": {
                "src": "getRandomNumber",
                "onDone": {
                  "target": "success",
                  "actions": "[Node: assign(({ event }) => ({\n                              result2: event.output.result\n                            }))]"
                }
              }
            },
            "success": {
              "type": "final"
            }
          }
        }
      },
      "onDone": "done"
    },
    "done": {
      "type": "final"
    }
  }
}
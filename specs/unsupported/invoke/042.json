{
  "id": "interval",
  "initial": "counting",
  "context": {
    "count": 0
  },
  "states": {
    "counting": {
      "invoke": {
        "id": "intervalService",
        "src": "[Call: fromCallback]"
      },
      "always": {
        "target": "finished",
        "guard": "[Function/Identifier: ({ context }) => context.count...]"
      },
      "on": {
        "INC": {
          "actions": "[Call: assign]"
        }
      }
    },
    "finished": {
      "type": "final"
    }
  }
}
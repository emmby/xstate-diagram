{
  "id": "ping",
  "initial": "innerMachine",
  "states": {
    "innerMachine": {
      "initial": "active",
      "states": {
        "active": {
          "invoke": {
            "id": "pong",
            "src": "[Node: pongMachine]"
          },
          "entry": "[Node: sendTo('pong', { type: 'PING' })]",
          "on": {
            "PONG": "innerSuccess"
          }
        },
        "innerSuccess": {
          "type": "final"
        }
      },
      "onDone": "success"
    },
    "success": {
      "type": "final"
    }
  }
}
{
  "id": "parent",
  "initial": "idle",
  "states": {
    "idle": {
      "on": {
        "START": "active"
      }
    },
    "active": {
      "invoke": {
        "src": "[Node: child]"
      },
      "on": {
        "STOPPED": "done"
      }
    },
    "done": {
      "type": "final"
    }
  }
}
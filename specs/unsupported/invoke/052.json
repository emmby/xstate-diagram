{
  "types": "[Node: {} as { context: Ctx; events: Events }]",
  "id": "obs",
  "initial": "counting",
  "context": {
    "count": "[Node: undefined]"
  },
  "states": {
    "counting": {
      "invoke": {
        "src": "[Node: fromObservable(() => interval(10).pipe(take(5)))]",
        "onSnapshot": {
          "actions": "[Node: assign({\n                  count: ({ event }) => event.snapshot.context\n                })]"
        },
        "onDone": {
          "target": "counted",
          "guard": "[Node: ({ context }) => context.count === 4]"
        }
      }
    },
    "counted": {
      "type": "final"
    }
  }
}
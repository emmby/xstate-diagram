{
  "id": "observable",
  "initial": "idle",
  "context": {
    "observableRef": "[Node: undefined! as AnyActorRef]"
  },
  "states": {
    "idle": {
      "entry": "[Node: assign({\n              observableRef: ({ spawn }) => spawn('interval', { id: 'int' })\n            })]",
      "on": {
        "COUNT": {
          "target": "success",
          "guard": "[Node: ({ event }) => event.val === 5]"
        }
      }
    },
    "success": {
      "type": "final"
    }
  }
}
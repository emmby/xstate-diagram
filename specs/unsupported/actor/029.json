{
  "types": "[Node: {} as {\n          context: { ponger: ActorRefFrom<typeof pongLogic> | undefined };\n        }]",
  "initial": "waiting",
  "context": {
    "ponger": "[Node: undefined]"
  },
  "entry": "[Node: assign({\n          ponger: ({ spawn }) => spawn(pongLogic)\n        })]",
  "states": {
    "waiting": {
      "entry": "[Node: sendTo(({ context }) => context.ponger!, { type: 'PING' })]",
      "invoke": {
        "id": "ponger",
        "src": "[Node: pongLogic]"
      },
      "on": {
        "PONG": "success"
      }
    },
    "success": {
      "type": "final"
    }
  }
}
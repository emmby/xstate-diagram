{
  "initial": "closed",
  "states": {
    "closed": {
      "id": "closed",
      "on": {
        "BUTTON.CLICK": "open.hist"
      }
    },
    "open": {
      "on": {
        "BUTTON.CLICK": "closed"
      },
      "initial": "first",
      "states": {
        "hist": {
          "type": "history"
        },
        "first": {
          "on": {
            "NEXT": "second"
          }
        },
        "second": {
          "on": {
            "CLOSE": "#closed"
          }
        }
      }
    }
  }
}
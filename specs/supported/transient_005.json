{
  "initial": "A",
  "states": {
    "A": {
      "exit": "[Node: () => actual.push('exit_A')]",
      "on": {
        "TIMER": {
          "target": "T",
          "actions": "[Node: () => actual.push('timer')]"
        }
      }
    },
    "T": {
      "always": [
        {
          "target": "B"
        }
      ]
    },
    "B": {
      "entry": "[Node: () => actual.push('enter_B')]"
    }
  }
}